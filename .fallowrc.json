{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": ["src/main.ts", "src/ui/diff-highlighter.ts", "tests/**/*.test.{ts,tsx}"],
  "ignorePatterns": ["dist/**", "coverage/**", "node_modules/**", ".fallow/**"],
  "ignoreDependencies": ["obsidian"],
  "usedClassMembers": ["onload", "onunload", "display", "onOpen", "onClose"],
  "typeAware": { "enabled": true },
  "health": { "ignore": ["tests/**"] },
  "duplicates": { "ignore": ["tests/**"] }
}
