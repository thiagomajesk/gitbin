function statusColor(warning: bool, status: string): Option<string>
{
  if warning then
    Option.Some("gitbin-status-warning")
  else
    if (status == "All changes synced") then
      Option.Some("gitbin-status-current")
    else
      Option.None
}

lemma statusColor_ensures(warning: bool, status: string)
  ensures (warning ==> (match statusColor(warning, status) { case Some(i_value) => (i_value == "gitbin-status-warning") case None => false }))
  ensures (!(warning) ==> (statusColor(warning, status) == (if (status == "All changes synced") then Option.Some("gitbin-status-current") else Option.None)))
