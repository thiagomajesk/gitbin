function repositoryState(hasCurrent: bool, changed: Option<bool>, hasSync: bool): string
{
  if (hasCurrent && (match changed { case Some(i_) => false case None => true })) then
    "Not verified"
  else
    if (hasCurrent && (match changed { case Some(i_value) => (i_value == true) case None => false })) then
      "Files waiting to sync"
    else
      if hasSync then
        "All changes synced"
      else
        "Connected"
}

