function syncState(connected: bool, error: bool, issue: Option<string>, status: string, stale: bool, pending: bool, repository: string): string
{
  if !(connected) then
    "Not connected"
  else
    if error then
      match issue {
        case Some(i_issue_val) =>
          i_issue_val
        case None =>
          "Last sync failed"
      }
    else
      if (status == "Syncing\u2026") then
        "Syncing your changes"
      else
        if stale then
          if (|status| >= |"Offline"| && status[..|"Offline"|] == "Offline") then
            "Working offline"
          else
            "Last known state"
        else
          if pending then
            "Files waiting to sync"
          else
            repository
}

