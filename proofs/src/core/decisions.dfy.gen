function changeKind(baseline: Option<Snapshot>, local: Option<Snapshot>, incoming: Option<Snapshot>, known: bool): ChangeKind
{
  if !(known) then
    ChangeKind.synced
  else
    var localChanged := !(same(baseline, local));
    var incomingChanged := !(same(baseline, incoming));
    if ((localChanged && incomingChanged) && !(same(local, incoming))) then
      ChangeKind.combined
    else
      if incomingChanged then
        ChangeKind.incoming
      else
        ChangeKind.local
}

