function ownerAt(owners: seq<string>, key: string): Option<string>
{
  SeqFind(owners, (existing: string) => (((existing == key) || (|existing| >= |(key + "/")| && existing[..|(key + "/")|] == (key + "/"))) || (|key| >= |(existing + "/")| && key[..|(existing + "/")|] == (existing + "/"))))
}

