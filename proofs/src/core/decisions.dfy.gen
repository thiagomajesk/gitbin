method migrationSequence(applied: seq<string>, expected: seq<string>) returns (res: MigrationSequence)
  ensures (res.newer? == exists i: int :: (((0 <= i) && (i < |applied|)) && !((applied[i] in expected))))
  ensures (res.supported? == ((|applied| <= |expected|) && forall i: int :: ((0 <= i) ==> (i < |applied|) ==> (applied[i] == expected[i]))))
  ensures (res.invalid? == ((forall i: int :: ((0 <= i) ==> (i < |applied|) ==> (applied[i] in expected))) && !(((|applied| <= |expected|) && forall i: int :: ((0 <= i) ==> (i < |applied|) ==> (applied[i] == expected[i]))))))
{
  if (exists id :: id in applied && !((id in expected))) {
    return MigrationSequence.newer;
  }
  if (|applied| > |expected|) {
    return MigrationSequence.invalid;
  }
  var index := 0;
  while (index < |applied|)
    invariant (0 <= index)
    invariant (index <= |applied|)
    invariant forall j: int :: ((0 <= j) ==> (j < index) ==> (applied[j] == expected[j]))
    decreases (|applied| - index)
  {
    if (applied[index] != expected[index]) {
      return MigrationSequence.invalid;
    }
    index := (index + 1);
  }
  return MigrationSequence.supported;
}
